# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL connection string (intended database)
# Falls back automatically and cleanly to SQLite (sqlite:///./campusflow.db) if PostgreSQL is offline
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/campusflow"

# Main Backend API Base URL
VITE_API_BASE_URL="http://127.0.0.1:8002"

# ML Microservice datathonapi Base URL
VITE_ML_API_BASE_URL="http://127.0.0.1:8001"
ML_API_BASE_URL="http://127.0.0.1:8001"

